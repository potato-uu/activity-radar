# Copy to .env locally. Never commit real credentials.
CODEX_API_KEY=
OPENAI_API_KEY=
CODEX_BASE_URL=https://api.openai.com/v1
RADAR_MODEL=gpt-5.5
RADAR_PUSH_TARGET=weixin
RADAR_INPUT_PRICE_PER_MILLION=
RADAR_OUTPUT_PRICE_PER_MILLION=
# Per-source web-search tuning. Each source runs independently.
RADAR_SOURCE_TIMEOUT_SECONDS=180
RADAR_SOURCE_RETRIES=2
RADAR_DISCOVERY_CONCURRENCY=3
